<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Modelos de calzado | Producción de Calzado</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <a class="visually-hidden-focusable" href="#contenido">Saltar al contenido</a>
  <nav class="navbar navbar-dark bg-dark" aria-label="Navegación principal">
    <div class="container"><a href="/" class="navbar-brand">Producción de Calzado</a><a href="/modelos" class="nav-link text-white" aria-current="page">Modelos</a></div>
  </nav>
  <main id="contenido" class="container py-4 py-lg-5">
    <header class="mb-4"><h1 class="h2">Modelos de calzado</h1><p class="text-secondary">Registra los modelos que utilizarás en la producción.</p></header>
    <% if (guardado) { %><div class="alert alert-success" role="status">Modelo guardado correctamente.</div><% } %>
    <% if (Object.keys(errors).length) { %><div class="alert alert-danger" role="alert">No se guardó el modelo. Revisa los campos indicados.</div><% } %>
    <div class="row g-5">
      <section class="col-lg-4" aria-labelledby="nuevo-modelo">
        <h2 id="nuevo-modelo" class="h4 mb-3">Registrar modelo</h2>
        <p class="small text-secondary">Todos los campos son obligatorios.</p>
        <form method="post" action="/modelos">
          <% for (const field of ["codigo", "nombre", "descripcion"]) {
            const labels = { codigo: "Código", nombre: "Nombre", descripcion: "Descripción" };
            const limits = { codigo: 30, nombre: 100, descripcion: 1000 };
          %>
          <div class="mb-3">
            <label for="<%= field %>" class="form-label"><%= labels[field] %></label>
            <% if (field === "descripcion") { %>
              <textarea id="descripcion" name="descripcion" rows="4" maxlength="1000" required class="form-control<%= errors[field] ? ' is-invalid' : '' %>" aria-invalid="<%= !!errors[field] %>" aria-describedby="descripcion-ayuda<%= errors[field] ? ' descripcion-error' : '' %>"><%= values[field] || '' %></textarea>
            <% } else { %>
              <input id="<%= field %>" name="<%= field %>" value="<%= values[field] || '' %>" maxlength="<%= limits[field] %>" required class="form-control<%= errors[field] ? ' is-invalid' : '' %>" aria-invalid="<%= !!errors[field] %>" aria-describedby="<%= field %>-ayuda<%= errors[field] ? ' ' + field + '-error' : '' %>" <% if (field === "codigo") { %>pattern="[A-Za-z0-9][A-Za-z0-9_\-]{0,29}" autocapitalize="characters" spellcheck="false"<% } %>>
            <% } %>
            <div id="<%= field %>-ayuda" class="form-text"><%= field === 'codigo' ? 'Hasta 30 caracteres. Letras sin tildes, números, guion o guion bajo. Se guarda en mayúsculas.' : 'Máximo ' + limits[field] + ' caracteres.' %></div>
            <% if (errors[field]) { %><div id="<%= field %>-error" class="invalid-feedback"><%= errors[field] %></div><% } %>
          </div>
          <% } %>
          <button type="submit" class="btn btn-dark">Guardar modelo</button>
        </form>
      </section>
      <section class="col-lg-8" aria-labelledby="modelos-registrados">
        <div class="d-flex align-items-baseline justify-content-between gap-3 mb-3"><h2 id="modelos-registrados" class="h4">Modelos registrados</h2><span class="text-secondary"><%= modelos.length %> en total</span></div>
        <% if (!modelos.length) { %>
          <div class="border-top py-4"><h3 class="h5">Registra tu primer modelo</h3><p class="text-secondary">Completa el formulario con su código, nombre y descripción. Aquí podrás consultar los modelos guardados.</p></div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table align-middle"><caption>Modelos guardados, del más reciente al más antiguo.</caption>
              <thead><tr><th scope="col">Código</th><th scope="col">Nombre</th><th scope="col">Descripción</th></tr></thead>
              <tbody><% for (const modelo of modelos) { %><tr><th scope="row" class="text-break"><%= modelo.codigo %></th><td class="text-break"><%= modelo.nombre %></td><td class="text-break" style="white-space: pre-wrap"><%= modelo.descripcion %></td></tr><% } %></tbody>
            </table>
          </div>
        <% } %>
      </section>
    </div>
  </main>
</body>
</html>
